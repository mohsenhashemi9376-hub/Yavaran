# ==========================================================
#  مدرسه یاوران ولایت — .htaccess ریشه (public_html)
#  تمام درخواست‌ها به پوشه public هدایت می‌شوند و
#  دسترسی مستقیم به فایل‌ها و پوشه‌های حساس مسدود است.
# ==========================================================

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- اجبار HTTPS (برای نصب PWA الزامی است؛ اگر هاست SSL ندارد این ۴ خط را حذف کنید) ---
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- انتقال هدر احراز هویت ---
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # --- مسدودسازی فایل‌های مخفی (.env, .git, ...) ---
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # --- مسدودسازی فایل‌های حساس ریشه ---
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.ts|tsconfig\.json|database\.sql|.*\.md)$ - [F,L,NC]

    # --- مسدودسازی فایل‌های پشتیبان و کلید (حتی اگر اشتباهاً در وب‌روت بمانند) ---
    RewriteRule \.(sql|sqlite|bak|enc|key|gz|log)$ - [F,L,NC]

    # --- مسدودسازی پوشه‌های داخلی لاراول ---
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L,NC]

    # --- هدایت همه درخواست‌ها به پوشه public ---
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
