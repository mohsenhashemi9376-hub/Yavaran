APP_NAME="مدرسه یاوران ولایت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ورود دومرحله‌ای (TOTP) اجباری برای مربی و معاون تربیتی
REQUIRE_2FA_NURTURING=true
# تأیید مجدد رمز برای پرونده‌های تربیتی (دقیقه بی‌فعالیتی)
REQUIRE_REAUTH_NURTURING=true
REAUTH_MINUTES=360
# enforce | report-only | off
CSP_MODE=enforce
# ساعت مدرسه (هشدار دسترسی خارج از بازه)
NURTURING_HOURS_START=6
NURTURING_HOURS_END=20
APP_URL=https://your-domain.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- اطلاعات دیتابیس (از بخش MySQL Databases در cPanel) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_yavaran
DB_USERNAME=cpaneluser_yavaran
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- امنیت مربی و معاون تربیتی ----
# حداقل طول رمز عبور
NURTURING_PASSWORD_MIN=8
# ورود دومرحله‌ای فقط در اولین ورود با هر دستگاه (دستگاه مطمئن) لازم است؛ مدت اعتبار (روز)
TRUSTED_DEVICE_DAYS=180

# ---- سخت‌گیری بیشتر (پیشنهادی) ----
# آدرس IP پروکسی/CDN هاست (با ویرگول)؛ خالی یا * یعنی هر هدر X-Forwarded-For پذیرفته می‌شود
TRUSTED_PROXIES=*
# دستگاه مطمئن مربی و معاون تربیتی (روز)
TRUSTED_DEVICE_DAYS_NURTURING=14
# عمر مطلق نشست مربی و معاون تربیتی (ساعت) و بی‌فعالیتی (دقیقه؛ ۰ = غیرفعال)
NURTURING_SESSION_MAX_HOURS=14
NURTURING_IDLE_MINUTES=0
# سقف باز کردن پرونده توسط مربی (در ۱۰ دقیقه / در روز) پیش از قفل موقت
NURTURING_BULK_BLOCK_LIMIT=30
NURTURING_DAILY_VIEW_LIMIT=150
# کوکی نشست رمز می‌شود و روی HTTPS فقط امن ارسال می‌شود
SESSION_ENCRYPT=true

# ---- کلید اختصاصی اطلاعات تربیتی (php artisan nurturing:generate-key) ----
# ترجیحاً مسیر فایل کلید بیرون از public_html (فقط‌خواندنی برای PHP)؛ یا مقدار base64 در NURTURING_KEY
NURTURING_KEY_FILE=
NURTURING_KEY=
# کلیدهای قبلی (از جمله APP_KEY) برای خواندن داده‌های قدیمی تا پایان php artisan nurturing:rotate-key
NURTURING_KEY_PREVIOUS=
# ---- پشتیبان رمزنگاری‌شده روزانه (نیازمند کرون schedule:run) ----
BACKUP_KEY=
BACKUP_KEEP_DAYS=7
# ---- هشدار در ایتا (ربات ایتایار؛ ربات باید در کانال/گروه مدیر باشد) ----
EITAA_TOKEN=
EITAA_CHAT_ID=
# ---- محدودیت دسترسی مربی/معاون تربیتی: IP/CIDR مجاز (با ویرگول) و اجبار ساعت مدرسه برای مربی ----
NURTURING_ALLOWED_IPS=
NURTURING_ENFORCE_HOURS=false
