APP_NAME="مدرسه یاوران ولایت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ورود دومرحله‌ای (TOTP) اجباری برای مربی و معاون تربیتی
REQUIRE_2FA_NURTURING=true
# تأیید مجدد رمز برای پرونده‌های تربیتی (دقیقه بی‌فعالیتی)
REQUIRE_REAUTH_NURTURING=true
REAUTH_MINUTES=30
# enforce | report-only | off
CSP_MODE=enforce
# ساعت مدرسه (هشدار دسترسی خارج از بازه)
NURTURING_HOURS_START=6
NURTURING_HOURS_END=20
APP_URL=https://your-domain.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- اطلاعات دیتابیس (از بخش MySQL Databases در cPanel) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_yavaran
DB_USERNAME=cpaneluser_yavaran
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=600
SESSION_SECURE_COOKIE=
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
